# ================================================
# .gitignore — clan-platform-domain-be
# ================================================

# ==================== ENV FILES ====================
# .env.local  — local dev config       → NOT committed (real DB passwords)
# .env.prod   — production config      → NOT committed (ENCRYPTION_KEY + prod secrets)
# .env.dev    — dev template           → committed (placeholder values only)
# .env.uat    — UAT template           → committed (placeholder values only)
.env
.env.local
.env.prod
*.env

# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
venv/
env/
ENV/
.venv/
pip-log.txt

# ==================== Testing ====================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache

# ==================== IDE ====================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==================== Logs ====================
*.log
logs/

# ==================== Database ====================
*.db
*.sqlite

# ==================== Docker ====================
docker-compose.override.yml
