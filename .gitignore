# ================================================
# .gitignore — clan-platform-domain-be
# ================================================

# ==================== ENV FILES (NEVER COMMIT) ====================
# .env.local  — local dev config (contains dev secrets)
# .env.prod   — production config (contains ENCRYPTION_KEY and prod secrets)
# Allow only *.example files to be committed as reference templates
.env
.env.local
.env.prod
.env.uat
.env.dev
*.env
!*.env.example

# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
venv/
env/
ENV/
.venv/
pip-log.txt

# ==================== Testing ====================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache

# ==================== IDE ====================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==================== Logs ====================
*.log
logs/

# ==================== Database ====================
*.db
*.sqlite

# ==================== Docker ====================
docker-compose.override.yml
