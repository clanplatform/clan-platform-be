# ================================================
# ADMIN SERVICE - DEVELOPMENT ENVIRONMENT
# ================================================

# ==================== APPLICATIONs ====================
APP_NAME=Admin Service
APP_VERSION=1.0.0
APP_DESCRIPTION=Platform Admin Service for managing domains and applications
DEBUG=true
ENVIRONMENT=development

# ==================== DATABASE - POSTGRESQL ====================
DATABASE_URL=postgresql://postgres:root@dev-postgres.example.com:5432/admin_service

# ==================== CACHE - REDIS ====================
REDIS_URL=redis://dev-redis.example.com:6379/0
CACHE_DEFAULT_TTL=1800

# ==================== DATABASE - MONGODB ====================
MONGODB_URL=mongodb://dev-mongodb.example.com:27017
MONGODB_DB_NAME=admin_service

# ==================== SECURITY & AUTHENTICATION ====================
SECRET_KEY=dev-secret-key-replace-with-strong-random-value-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================== IDENTITY SERVICE ====================
IDENTITY_SERVICE_URL=https://identity-dev.example.com

# ==================== CORS ====================
CORS_ORIGINS=["https://dev.example.com","http://localhost:3000"]

# ==================== KAFKA MESSAGING ====================
KAFKA_BOOTSTRAP_SERVERS=dev-kafka.example.com:9092
KAFKA_TOPIC_PREFIX=admin-service-dev
KAFKA_GROUP_ID=admin-service-dev

# ==================== LOGGING ====================
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ==================== SERVICE CONFIGURATION ====================
SERVICE_PORT=8000
UVICORN_WORKERS=2
