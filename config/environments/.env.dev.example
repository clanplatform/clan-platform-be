# ================================================
# ADMIN SERVICE — DEVELOPMENT / STAGING (Render)
# ================================================
# Copy these variables into your Render service's Environment tab.
# Encryption is DISABLED in this environment (no ENCRYPTION_KEY set).

# ==================== APPLICATION ====================
APP_NAME=Admin Service
APP_VERSION=1.0.0
APP_DESCRIPTION=Platform Admin Service for managing domains and applications
DEBUG=true
ENVIRONMENT=development

# ==================== DATABASE - POSTGRESQL ====================
# Render → add a PostgreSQL database and copy the Internal URL here
DATABASE_URL=postgresql://postgres:CHANGE_ME@dpg-xxxx.oregon-postgres.render.com:5432/admin_service_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# ==================== CACHE - REDIS ====================
# Render → add a Redis instance and copy the Internal URL here
REDIS_URL=redis://CHANGE_ME@oregon-redis.render.com:6379
CACHE_DEFAULT_TTL=1800
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ==================== DATABASE - MONGODB ====================
# Use MongoDB Atlas free tier for dev
MONGODB_URL=mongodb+srv://CHANGE_ME_USER:CHANGE_ME_PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=admin_service_dev
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# ==================== SECURITY & AUTHENTICATION ====================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_DEV_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================== ENCRYPTION (AES-256-GCM) ====================
# DISABLED in dev — do NOT set ENCRYPTION_KEY here.
# Leaving it unset means encrypt/decrypt are plaintext passthrough.
# ENCRYPTION_KEY=

# ==================== AUDIT SERVICE ====================
# URL of the audit-service Render deployment (dev instance)
AUDIT_SERVICE_URL=https://audit-service-dev.onrender.com

# ==================== IDENTITY SERVICE ====================
IDENTITY_SERVICE_URL=https://identity-service-dev.onrender.com

# ==================== CORS ====================
CORS_ORIGINS=["https://dev.example.com","http://localhost:3000","http://localhost:8080"]

# ==================== LOGGING ====================
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ==================== SERVICE CONFIGURATION ====================
SERVICE_PORT=8000
UVICORN_WORKERS=2

# ==================== FEATURE FLAGS ====================
FEATURE_AUDIT_LOG=true
FEATURE_EVENT_PUBLISHING=false
FEATURE_RATE_LIMITING=false
