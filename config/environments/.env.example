# ================================================
# ADMIN SERVICE - ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================
# This is a generic template. Copy to .env and update values.
# For environment-specific examples, see:
#   - .env.local.example (local development)
#   - .env.dev.example (development)
#   - .env.uat.example (UAT/staging)
#   - .env.prod.example (production)

# ==================== APPLICATION ====================
APP_NAME=Admin Service
APP_VERSION=1.0.0
APP_DESCRIPTION=Platform Admin Service for managing domains and applications
DEBUG=false
ENVIRONMENT=development

# ==================== DATABASE - POSTGRESQL ====================
DATABASE_URL=postgresql://username:password@host:port/database

# ==================== CACHE - REDIS ====================
REDIS_URL=redis://host:port/0
CACHE_DEFAULT_TTL=1800

# ==================== DATABASE - MONGODB ====================
MONGODB_URL=mongodb://host:port
MONGODB_DB_NAME=admin_service

# ==================== SECURITY & AUTHENTICATION ====================
SECRET_KEY=change-this-secret-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== IDENTITY SERVICE (OPTIONAL) ====================
IDENTITY_SERVICE_URL=http://identity-service:8001

# ==================== CORS ====================
CORS_ORIGINS=["*"]

# ==================== KAFKA MESSAGING (OPTIONAL) ====================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=admin-service

# ==================== LOGGING ====================
LOG_LEVEL=INFO
