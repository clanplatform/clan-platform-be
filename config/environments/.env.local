# ================================================
# ADMIN SERVICE - LOCAL ENVIRONMENT CONFIGURATION
# ================================================
# This file contains all environment variables required for the admin-service
# Copy this file to .env in the service root and update values as needed

# ==================== APPLICATION ====================
APP_NAME=Admin Service
APP_VERSION=1.0.0
APP_DESCRIPTION=Platform Admin Service for managing domains and applications
DEBUG=true
ENVIRONMENT=local

# ==================== DATABASE - POSTGRESQL ====================
# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:root@localhost:5432/admin_service

# Connection pool settings (optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# ==================== CACHE - REDIS ====================
# Redis connection URL
# Format: redis://[:password]@host:port/database
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (1-86400 range, default 1800 = 30 minutes)
CACHE_DEFAULT_TTL=1800

# Redis connection settings (optional)
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ==================== DATABASE - MONGODB ====================
# MongoDB connection URL
# Format: mongodb://[username:password@]host:port
# For docker-compose MongoDB with auth: mongodb://admin:admin_pass@localhost:27017
# For local MongoDB without auth: mongodb://localhost:27017
MONGODB_URL=mongodb://admin:admin_pass@localhost:27017

# MongoDB database name
MONGODB_DB_NAME=admin_service

# MongoDB connection settings (optional)
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# ==================== SECURITY & AUTHENTICATION ====================
# Secret key for JWT token signing and encryption
# IMPORTANT: Change this in production! Minimum 32 characters
SECRET_KEY=local-dev-secret-key-change-in-production-min-32-chars-long

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== IDENTITY SERVICE (OPTIONAL) ====================
# External identity service URL for authentication
IDENTITY_SERVICE_URL=http://localhost:8001

# ==================== CORS ====================
# Allowed CORS origins (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:4200"]

# ==================== KAFKA MESSAGING (OPTIONAL) ====================
# Kafka bootstrap servers (comma-separated)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka topic prefix for this service
KAFKA_TOPIC_PREFIX=admin-service

# Kafka group ID
KAFKA_GROUP_ID=admin-service-local

# ==================== LOGGING ====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Log format: json or text
LOG_FORMAT=json

# ==================== SERVICE PORTS ====================
# Service port
SERVICE_PORT=8000

# Uvicorn workers (for production)
UVICORN_WORKERS=1

# ==================== FEATURE FLAGS (OPTIONAL) ====================
# Enable/disable features
FEATURE_AUDIT_LOG=true
FEATURE_EVENT_PUBLISHING=false
FEATURE_RATE_LIMITING=false

# ==================== DOCKER COMPOSE OVERRIDES ====================
# These are used by docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=admin_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

REDIS_HOST=redis
REDIS_PORT=6379

MONGODB_HOST=mongodb
MONGODB_PORT=27017
