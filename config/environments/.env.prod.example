# ================================================
# ADMIN SERVICE - PRODUCTION ENVIRONMENT
# ================================================
# SECURITY WARNING: Never commit actual production credentials to version control
# Use secret management systems (AWS Secrets Manager, Azure Key Vault, etc.)

# ==================== APPLICATION ====================
APP_NAME=Admin Service
APP_VERSION=1.0.0
APP_DESCRIPTION=Platform Admin Service for managing domains and applications
DEBUG=false
ENVIRONMENT=production

# ==================== DATABASE - POSTGRESQL ====================
# IMPORTANT: Use strong passwords and consider using IAM authentication
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@prod-postgres.example.com:5432/admin_service
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true

# ==================== CACHE - REDIS ====================
# IMPORTANT: Always use password authentication in production
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@prod-redis.example.com:6379/0
CACHE_DEFAULT_TTL=1800
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ==================== DATABASE - MONGODB ====================
# IMPORTANT: Use authentication and TLS in production
MONGODB_URL=mongodb://admin:CHANGE_ME_MONGO_PASSWORD@prod-mongodb.example.com:27017/?ssl=true&authSource=admin
MONGODB_DB_NAME=admin_service
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# ==================== SECURITY & AUTHENTICATION ====================
# CRITICAL: Generate a strong random secret key (minimum 64 characters recommended)
# Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_USE_STRONG_RANDOM_SECRET_MINIMUM_64_CHARACTERS_GENERATED_SECURELY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ==================== IDENTITY SERVICE ====================
IDENTITY_SERVICE_URL=https://identity.example.com

# ==================== CORS ====================
# IMPORTANT: Restrict to actual application domains only
CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]

# ==================== KAFKA MESSAGING ====================
# IMPORTANT: Use TLS and SASL authentication in production
KAFKA_BOOTSTRAP_SERVERS=prod-kafka-1.example.com:9093,prod-kafka-2.example.com:9093,prod-kafka-3.example.com:9093
KAFKA_TOPIC_PREFIX=admin-service-prod
KAFKA_GROUP_ID=admin-service-prod
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== SERVICE CONFIGURATION ====================
SERVICE_PORT=8000
UVICORN_WORKERS=8

# ==================== FEATURE FLAGS ====================
FEATURE_AUDIT_LOG=true
FEATURE_EVENT_PUBLISHING=true
FEATURE_RATE_LIMITING=true

# ==================== MONITORING & OBSERVABILITY ====================
# APM/Monitoring configuration (optional)
ENABLE_APM=true
APM_SERVICE_NAME=admin-service
APM_ENVIRONMENT=production

# ==================== SECURITY HEADERS ====================
ENABLE_HSTS=true
ENABLE_CSP=true

# ==================== RATE LIMITING ====================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20
