# ================================================
# ADMIN SERVICE - UAT/STAGING ENVIRONMENT
# ================================================

# ==================== APPLICATION ====================
APP_NAME=Admin Service
APP_VERSION=1.0.0
APP_DESCRIPTION=Platform Admin Service for managing domains and applications
DEBUG=false
ENVIRONMENT=uat

# ==================== DATABASE - POSTGRESQL ====================
DATABASE_URL=postgresql://postgres:admin_uat_pass@uat-postgres.example.com:5432/admin_service
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30

# ==================== CACHE - REDIS ====================
REDIS_URL=redis://:uat_redis_password@uat-redis.example.com:6379/0
CACHE_DEFAULT_TTL=1800

# ==================== DATABASE - MONGODB ====================
MONGODB_URL=mongodb://uat-mongodb.example.com:27017
MONGODB_DB_NAME=admin_service

# ==================== SECURITY & AUTHENTICATION ====================
SECRET_KEY=uat-secret-key-replace-with-strong-random-value-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== ENCRYPTION (AES-256-GCM) ====================
# NOT set in UAT environment — encryption is disabled (plaintext passthrough).
# Only set ENCRYPTION_KEY in production (.env.prod).
# ENCRYPTION_KEY=

# ==================== IDENTITY SERVICE ====================
IDENTITY_SERVICE_URL=https://identity-uat.example.com

# ==================== CORS ====================
CORS_ORIGINS=["https://uat.example.com","https://staging.example.com"]

# ==================== KAFKA MESSAGING ====================
KAFKA_BOOTSTRAP_SERVERS=uat-kafka.example.com:9092
KAFKA_TOPIC_PREFIX=admin-service-uat
KAFKA_GROUP_ID=admin-service-uat

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== SERVICE CONFIGURATION ====================
SERVICE_PORT=8000
UVICORN_WORKERS=4

# ==================== FEATURE FLAGS ====================
FEATURE_AUDIT_LOG=true
FEATURE_EVENT_PUBLISHING=true
FEATURE_RATE_LIMITING=false
